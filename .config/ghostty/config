Ghostty config — migrated from ~/.config/alacritty/alacritty.toml
# Reload live with: ctrl+shift+,
# Validate with:    ghostty +validate-config

# FONT
font-family = JetBrainsMono Nerd Font
font-size = 12

# WINDOW
window-padding-x = 10
window-padding-y = 10
# Hyprland draws borders; drop the GTK titlebar/CSD
window-decoration = none
# Opacity is handled by Hyprland (window rule), like it was for Alacritty
background-opacity = 1
# Don't ask before closing a window
confirm-close-surface = false

# SCROLLBACK (bytes, not lines; ~10MB is plenty for 10k+ lines)
scrollback-limit = 10000000

# MOUSE
mouse-hide-while-typing = true

# CURSOR
cursor-style = underline
cursor-style-blink = true
# Stop shell integration from forcing a bar cursor at the prompt
shell-integration-features = no-cursor
# Cursor thickness: default is 1px (slimmest). Increase with e.g. adjust-cursor-thickness = 1

# Fade the hollow cursor box when the window is unfocused
custom-shader = shaders/fade-unfocused-cursor.glsl
# Shader is static; no need for a per-frame animation loop
custom-shader-animation = false

# COLORS - Gruvbox Material Dark Medium (exact palette from Alacritty)
background = #282828
foreground = #d4be98
cursor-color = #a89984
cursor-text = #282828
selection-background = #d4be98
selection-foreground = #282828

palette = 0=#665c54
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#e78a4e
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98
palette = 8=#928374
palette = 9=#ea6962
palette = 10=#a9b665
palette = 11=#d8a657
palette = 12=#7daea3
palette = 13=#d3869b
palette = 14=#89b482
palette = 15=#d4be98

# KEYBINDINGS
# Shift+Enter sends ESC+CR (newline in Claude Code / pi etc.)
keybind = shift+enter=text:\x1b\r

# VI MODE (Ctrl+Space) — see vim-mode.conf
config-file = vim-mode.conf
